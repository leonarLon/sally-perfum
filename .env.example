# Copie para .env.local e preencha. NUNCA commite .env.local.

# --- Supabase (plano Free) — Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon/publishable). Pode ir para o navegador; a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role). SOMENTE servidor. Ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres, usada só pelo Supabase CLI (migrations e seed). Contém a senha do banco.
SUPABASE_DB_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pagamentos (Fase 8) — vazio = provedor simulado. Não configure credenciais reais neste projeto de estudo. ---
PAYMENT_PROVIDER=fake
# Segredo HMAC do webhook de pagamentos (32+ caracteres aleatórios). SOMENTE servidor.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# --- Conta do proprietário (Fase 5) — usadas só por scripts/admin/create-owner.mjs e pelo E2E do painel. ---
# Senha com 12+ caracteres. Depois de criar a conta, apague ADMIN_PASSWORD daqui.
ADMIN_EMAIL=
ADMIN_PASSWORD=
